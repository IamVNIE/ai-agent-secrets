{
  "name": "ai-agent-secret",
  "version": "0.4.0",
  "description": "Keep secrets away from AI coding agents (Claude Code, Cursor, Codex, Copilot): encrypted .env files with keys outside the project, plus automatic secret redaction of command output and agent tool results.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IamVNIE/ai-agent-secret.git"
  },
  "homepage": "https://github.com/IamVNIE/ai-agent-secret#readme",
  "bugs": {
    "url": "https://github.com/IamVNIE/ai-agent-secret/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agentshield": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "ai-agents",
    "secrets",
    "secret-management",
    "dotenv",
    "env",
    "encrypted-env",
    "dotenv-encrypt",
    "env-encryption",
    "encryption",
    "redaction",
    "secret-redaction",
    "llm",
    "llm-security",
    "ai-security",
    "claude-code",
    "cursor",
    "codex",
    "copilot",
    "coding-agent",
    "agent-hooks",
    "api-keys",
    "security"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
